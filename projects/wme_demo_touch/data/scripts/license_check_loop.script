#include "scripts\base.inc"

global num_license_checks = 0;

var licenseCheckSummary;

while (true)
{
	if (Game.LicenseCheckPending() == true)
	{
		Game.LicenseCheckAbort();	
	}
	
	Game.LicenseCheckStart();
	
	num_license_checks = num_license_checks + 1;
	
	// wait a while for the result (30 s)
	Sleep(30000);
	
	licenseCheckSummary = Game.LicenseCheckResultSummary();
	
	if (licenseCheckSummary == "UNKNOWN")
	{
		// try again after a short idle time (30 s)
		Sleep(30000);
	}
	else
	{
		// license check has a valid result, so it needs a refresh after long wait only
		// use 10 minutes (600 s) as an example
		Sleep(600000);
	}
}
