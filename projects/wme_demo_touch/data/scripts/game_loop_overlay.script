#include "scripts\base.inc"

// this script runs in an endless loop and does all the user-interface work
// that needs to be periodically updated
// such as the floating items captions display and positioning
// and the sliding inventory window handling

global WinCaption;
global WinMenu;


global g_CurrSelectedObject;
global g_CurrSelectedObjectStartTime;

global g_IsLeftClick;

// infinite loop
while(true)
{
	if (!g_IsLeftClick)
	{
	}
	else
	{
		// save the active object for later
		var ActObj = Game.ActiveObject;
		
		if (g_CurrSelectedObject != null)
		{
			// update current object if it changed from initial touch
			if (g_CurrSelectedObject != ActObj)
			{
				g_CurrSelectedObject = ActObj;
				g_CurrSelectedObjectStartTime = Game.CurrentTime;
			}
			// show overlay menu if an object touched for longer
			else
			{
				if (((Game.CurrentTime - g_CurrSelectedObjectStartTime) > LONG_CLICK_TIME_MS) && (Game.SelectedItem == null))
				{
					if (Game.DisplayVerbMenu(ActObj)) g_IsLeftClick = false;
				}
			} 
		}
		else
		{
			g_CurrSelectedObject = ActObj;
			g_CurrSelectedObjectStartTime = Game.CurrentTime;
		}
	}
	
	// go to sleep for 20 miliseconds to allow the engine to perform other tasks
	// it is important for the "endless" scripts to call the Sleep command, otherwise the game will get stuck
	Sleep(20);
}

