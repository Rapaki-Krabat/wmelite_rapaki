#include "scripts\base.inc"

global WinCaption;

global g_IsLeftClick;

var caption_display_start_time = 0;

// infinite loop
while(true)
{
	// only show the caption if there is a touch
	if (!g_IsLeftClick)
	{
		if ((Game.CurrentTime - caption_display_start_time) > MIN_CAPTION_DISPLAY_TIME_MS)
		{
			WinCaption.Visible = false;
		}
	}
	else
	{
		// save the active object for later
		var ActObj = Game.ActiveObject;

		// hide the inventory
		if (Game.MouseY > 100) Game.InventoryVisible = false;
		
		// handle the standard floating caption
		if (Game.Interactive && (ActObj != null))
		{
			// HACK but not for exits when item selected (these cannot be combined anyway)
			if ((Game.SelectedItem == null) || (ActObj.CanHandleEvent("LeftDoubleClick") == false))
			{
				WinCaption.X = 0;
				WinCaption.Y = 600 - 40;
				WinCaption.Width = Game.ScreenWidth;
				WinCaption.TextAlign = TAL_CENTER;
				
				// normal caption
				if (Game.SelectedItem == null)
				{
					WinCaption.Text = ActObj.Caption;
				}
				// handle the caption when you want to use an object with another
				else
				{
					var Item = Game.SelectedItem;
					if (ActObj.Caption == "")
					{
						if (ActObj == actor)
						{
							WinCaption.Text = "Use " + Item.Caption + " with Molly";
						}
						else
						{
							// do not show empty captions when combining
							WinCaption.Text = "";	
						}
					}
					else
					{
						WinCaption.Text = "Use " + Item.Caption + " with " + ActObj.Caption;
					}
				}
				
				if (WinCaption.Text != "")
				{
					WinCaption.Visible = true;
					WinCaption.Focus();
					
					caption_display_start_time = Game.CurrentTime;
				}
			}
			else WinCaption.Visible = false;
		}
		else WinCaption.Visible = false;
	}
	
	// go to sleep for 20 miliseconds to allow the engine to perform other tasks
	// it is important for the "endless" scripts to call the Sleep command, otherwise the game will get stuck
	Sleep(20);
}

