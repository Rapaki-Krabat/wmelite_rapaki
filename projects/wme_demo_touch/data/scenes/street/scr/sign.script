#include "scripts\base.inc"

global inapp_disclaimer_shown;
global inappPurchaseManager;

////////////////////////////////////////////////////////////////////////////////
on "LightOn"
{
  var LightMap;
  LightMap = Scene.GetNode("lightmap_1");
  LightMap.AlphaColor = MakeRGBA(255, 174, 174);

  LightMap = Scene.GetNode("lightmap_2");
  LightMap.AlphaColor = MakeRGBA(254, 89, 89);
}


////////////////////////////////////////////////////////////////////////////////
on "LightOff"
{
  var LightMap;
  LightMap = Scene.GetNode("lightmap_1");
  LightMap.AlphaColor = MakeRGBA(255, 255, 255);

  LightMap = Scene.GetNode("lightmap_2");
  LightMap.AlphaColor = MakeRGBA(255, 255, 255);
}


////////////////////////////////////////////////////////////////////////////////
on "LookAt"
{
  actor.GoToObject(this);
  actor.Talk("I seriously doubt that this will attract the masses...");
}

////////////////////////////////////////////////////////////////////////////////
on "Take"
{
	actor.GoToObject(this);
	
	if (inapp_disclaimer_shown == false)
	{
		inapp_disclaimer_shown = true;

		Game.Interactive = false;

		actor.TurnTo(DI_DOWN);
		
		actor.Talk("Repeat this action to start an in app purchase.");
		
		actor.Talk("This is just to show the capabilities of the game engine.");
		
		actor.Talk("Do not execute this purchase unless you know what you are doing!");
		
		Game.Interactive = true;		
	}
	else
	{
		Game.Interactive = false;
		
		var status = inappPurchaseManager.purchaseItem();
		
		actor.TurnTo(DI_DOWN);
		
		actor.Talk(status);
		
		if (inappPurchaseManager.getLastPurchaseStatus() == false)
		{
			actor.Talk("In-app purchase was cancelled or failed!");	
		}
		
		Game.Interactive = true;	
	}
}

////////////////////////////////////////////////////////////////////////////////
on "LeftClick"
{
  actor.GoToObject(this);
}
