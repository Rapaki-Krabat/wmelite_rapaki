#include "scripts\base.inc"

// scene state
global StateStreet;

global inappPurchaseManager;

// default values
if(StateStreet==null)
{
  StateStreet.Visited = false;
}


actor.SkipTo(1027, 266);
actor.Direction = DI_DOWNRIGHT;
Scene.SkipTo(actor.X, actor.Y);



if(!StateStreet.Visited)
{
  StateStreet.Visited = true;
}

// (re-) validate in app purchase items when entering the scene
inappPurchaseManager.validateInAppPurchases();

