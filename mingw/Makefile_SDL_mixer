IDIR =../src

CC=i686-w64-mingw32-gcc
CPP=i686-w64-mingw32-g++

DEFINES=USE_SDL_MIXER

CFLAGS=-I$(IDIR) -I. -O2 -I../../SDL2/include/ -I../../libfreetype/include/ -I../../libfreetype/include/freetype2/ -Wall -Wextra

CPPFLAGS=-I$(IDIR) -I. -I../../libeffectsprivate/jni/ -I../../libeffectsprivate/jni/Reverb/lib/ -I../../libeffectsprivate/jni/Common/lib/ -I../../libecho/jni/ -D$(DEFINES) -O2 \
-I../../libfreetype/include/ -I../../libfreetype/include/freetype2/ -I../../SDL2/include/ -I../../SDL_mixer/src/ -I../../zlib/ \
-I../../libfreeimage/jni/Dist/ \
-Wall -Wextra -Wno-write-strings -Wno-unused -Wno-unused-parameter \
-fstrict-aliasing \
-D__EXCLUDE_LIBTHEORA_PLAYER__ -DLIBEFFECTS_NO_EXPORT_DLL_SYMBOLS -DLIBECHO_NO_EXPORT_DLL_SYMBOLS -DFREEIMAGE_LIB \
-DFREEIMAGE_LITE_BUILD -DFREEIMAGE_NOT_SO_LITE_BUILD


SRCDIR=../src

ODIR=obj_sdl_mixer

LIBS= ../../libecho/mingwout/libecho.a ../../libeffectsprivate/mingwout/libeffects.a \
../../SDL_mixer/src/libSDL_mixer.a \
../../libfreeimage/jni/Dist/libFreeImage.a \
-L../../libfreetype/objs/.libs/ -lfreetype-6 \
../../SDL2/build/SDL_windows_main.o \
-L../../SDL2/build/.libs/ -lSDL2 \
-L../../zlib/ -lzlib1

# -L../../libfreeimage/jni/Dist/ -lFreeImage \

