OBJCPP = $(patsubst %,$(ODIR)/%,$(_OBJCPP))

_OBJSND = BSoundBuffer.o BSoundMgr.o
OBJSND = $(patsubst %,$(ODIR)/%,$(_OBJSND))

wmelite_sdl_mixer.exe: $(OBJC) $(OBJCPP) $(OBJSND)
	$(CPP) --verbose -static-libgcc -static-libstdc++ -o $@ $^ $(CFLAGS) -mwindows $(LIBS)

$(ODIR)/ConvertUTF.o: $(SRCDIR)/ConvertUTF.c
	@mkdir -p $(ODIR)
	@echo " (CC) $<"
	@$(CC) -c -o $@ $< $(CFLAGS)

