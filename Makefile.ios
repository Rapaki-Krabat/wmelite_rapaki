# Configuration for iPhone OS, making static libs
# this will generate both iPhone (arm) and iPhoneSimulator (i686) libs

TARGET = wmelite
INCLUDE=-Ixcode-ios/dep/libfreeimage/include/ -Ixcode-ios/dep/libfreetype/include \
-Ixcode-ios/dep/libSDL2/include -Ixcode-ios/dep/libSDL2_mixer/include \
-Ixcode-ios/dep/libecho/include -Ixcode-ios/dep/libreverb/include \
-Ixcode-ios/dep/libreverb/include/Reverb/lib \
-Ixcode-ios/dep/libreverb/include/Common/lib -Isrc -I.
SRCS=\
src/ConvertUTF.c \
src/DirectoryOperations.c \
src/FileOperations.c \
src/AdActor.cpp \
src/AdActorDir.cpp \
src/AdEntity.cpp \
src/AdGame.cpp \
src/AdInventoryBox.cpp \
src/AdInventory.cpp \
src/AdItem.cpp \
src/AdLayer.cpp \
src/AdNodeState.cpp \
src/AdObject.cpp \
src/AdPath.cpp \
src/AdPathPoint.cpp \
src/AdRegion.cpp \
src/AdResponseBox.cpp \
src/AdResponseContext.cpp \
src/AdResponse.cpp \
src/AdRotLevel.cpp \
src/AdScaleLevel.cpp \
src/AdScene.cpp \
src/AdSceneNode.cpp \
src/AdSceneState.cpp \
src/AdSentence.cpp \
src/AdSpriteSet.cpp \
src/AdTalkDef.cpp \
src/AdTalkHolder.cpp \
src/AdTalkNode.cpp \
src/AdWaypointGroup.cpp \
src/BActiveRect.cpp \
src/BBase.cpp \
src/BDebugger.cpp \
src/BDiskFile.cpp \
src/BDynBuffer.cpp \
src/BEvent.cpp \
src/BFader.cpp \
src/BFile.cpp \
src/BFileEntry.cpp \
src/BFileManager.cpp \
src/BFontBitmap.cpp \
src/BFont.cpp \
src/BFontStorage.cpp \
src/BFontTT.cpp \
src/BFrame.cpp \
src/BGame.cpp \
src/BImage.cpp \
src/BKeyboardState.cpp \
src/BNamedObject.cpp \
src/BObject.cpp \
src/BPackage.cpp \
src/BParser.cpp \
src/BPersistMgr.cpp \
src/BPkgFile.cpp \
src/BPoint.cpp \
src/BQuickMsg.cpp \
src/BRegion.cpp \
src/BRegistry.cpp \
src/BRenderer.cpp \
src/BRenderSDL.cpp \
src/BResourceFile.cpp \
src/BResources.cpp \
src/BSaveThumbFile.cpp \
src/BSaveThumbHelper.cpp \
src/BScriptable.cpp \
src/BScriptHolder.cpp \
src/snd_SDL_mixer/BSoundBuffer.cpp \
src/BSound.cpp \
src/snd_SDL_mixer/BSoundMgr.cpp \
src/BSprite.cpp \
src/BStringTable.cpp \
src/BSubFrame.cpp \
src/BSurface.cpp \
src/BSurfaceSDL.cpp \
src/BSurfaceStorage.cpp \
src/BTransitionMgr.cpp \
src/BViewport.cpp \
src/crc.cpp \
src/FontGlyphCache.cpp \
src/main.cpp \
src/MathUtil.cpp \
src/Matrix4.cpp \
src/PartEmitter.cpp \
src/PartForce.cpp \
src/PartParticle.cpp \
src/PathUtil.cpp \
src/PlatformSDL.cpp \
src/ScEngine.cpp \
src/ScScript.cpp \
src/ScStack.cpp \
src/ScValue.cpp \
src/SdlUtil.cpp \
src/StringUtil.cpp \
src/SXArray.cpp \
src/SXDate.cpp \
src/SXFile.cpp \
src/SXMath.cpp \
src/SXMemBuffer.cpp \
src/SxObject.cpp \
src/SXStore.cpp \
src/SXString.cpp \
src/SysClass.cpp \
src/SysClassRegistry.cpp \
src/SysInstance.cpp \
src/tinyxml.cpp \
src/tinyxmlerror.cpp \
src/tinyxmlparser.cpp \
src/UIButton.cpp \
src/UIEdit.cpp \
src/UIEntity.cpp \
src/UIObject.cpp \
src/UIText.cpp \
src/UITiledImage.cpp \
src/UIWindow.cpp \
src/utils.cpp \
src/Vector2.cpp

MSRCS=\
src/IOS_StoreKit.m     \
src/ios_utils.m        \  
src/ios_licensecheck.m

ifeq ($(CUSTOM_PLATFORM_CONFIG),)
PLATFORM_CONFIG=./ios_platform_config.sh
else
PLATFORM_CONFIG=$(CUSTOM_PLATFORM_CONFIG)
endif

DEPS_INSTALLDIR=`$(PLATFORM_CONFIG) --installdir`

STD_CFLAGS_PHONE = `$(PLATFORM_CONFIG) --cflags` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__
STD_CXXFLAGS_PHONE = `$(PLATFORM_CONFIG) --cxxflags` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__
STD_COBJFLAGS_PHONE = `$(PLATFORM_CONFIG) --cobjflags` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__
STD_CFLAGS_SIM = `$(PLATFORM_CONFIG) --cflags_sim` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__
STD_CXXFLAGS_SIM = `$(PLATFORM_CONFIG) --cxxflags_sim` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__
STD_COBJFLAGS_SIM = `$(PLATFORM_CONFIG) --cobjflags_sim` -DUSE_SDL_MIXER -D__EXCLUDE_LIBTHEORA_PLAYER__

IPHONEOS_DEPLOYMENT_TARGET = `$(PLATFORM_CONFIG) --minversion`
IPHONESIM_DEPLOYMENT_TARGET = `$(PLATFORM_CONFIG) --minversion`

ARCH_SIM_I386 = i386
ARCH_SIM_X86_64 = x86_64
ARCH_PHONE_ARMV7 = armv7
ARCH_PHONE_ARMV7S = armv7s
ARCH_PHONE_ARM64 = arm64

SDKROOT_SIM = `$(PLATFORM_CONFIG) --sysroot-sim`
SDKROOT_PHONE = `$(PLATFORM_CONFIG) --sysroot-phone`

EXTRA_CFLAGS_SIM   += $(INCLUDE)
EXTRA_CFLAGS_PHONE += $(INCLUDE)
SRCS_TO_COMPILE=$(SRCS)
MSRCS_TO_COMPILE=$(MSRCS)

EXTRA_CFLAGS_SIM += -isysroot $(SDKROOT_SIM)
EXTRA_CFLAGS_SIM += -mios-simulator-version-min=$(IPHONESIM_DEPLOYMENT_TARGET)

EXTRA_CFLAGS_PHONE += -isysroot $(SDKROOT_PHONE)
EXTRA_CFLAGS_PHONE += -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET)

AR_SIM = `$(PLATFORM_CONFIG) --ar`
AR_PHONE = `$(PLATFORM_CONFIG) --ar`

CC_SIM = `$(PLATFORM_CONFIG) --cc`
CXX_SIM = `$(PLATFORM_CONFIG) --cxx`
COBJ_SIM= `$(PLATFORM_CONFIG) --cxx`
LIBTOOL_SIM = `$(PLATFORM_CONFIG) --libtool`
CC_PHONE = `$(PLATFORM_CONFIG) --cc`
CXX_PHONE = `$(PLATFORM_CONFIG) --cxx`
COBJ_PHONE = `$(PLATFORM_CONFIG) --cxx`
LIBTOOL_PHONE = `$(PLATFORM_CONFIG) --libtool`
LIPO = `$(PLATFORM_CONFIG) --lipo`

CFLAGS_SIM = $(STD_CFLAGS_SIM) $(EXTRA_CFLAGS_SIM)
CXXFLAGS_SIM += $(STD_CXXFLAGS_SIM) $(EXTRA_CFLAGS_SIM)
COBJFLAGS_SIM += $(STD_COBJFLAGS_SIM) -fno-objc-arc $(EXTRA_CFLAGS_SIM)

CFLAGS_PHONE = $(STD_CFLAGS_PHONE) $(EXTRA_CFLAGS_PHONE)
CXXFLAGS_PHONE += $(STD_CXXFLAGS_PHONE) $(EXTRA_CFLAGS_PHONE)
COBJFLAGS_PHONE += $(STD_COBJFLAGS_PHONE) -fno-objc-arc $(EXTRA_CFLAGS_PHONE)

LDFLAGS_SIM = xcode-ios/dep/libfreeimage/libcombined/libfreeimage.a \
xcode-ios/dep/libSDL2/libcombined/libSDL2.a \
xcode-ios/dep/libfreetype/libcombined/libfreetype.a \
xcode-ios/dep/libreverb/libcombined/libreverb.a \
xcode-ios/dep/libSDL2_mixer/libcombined/libSDL2_mixer.a \
xcode-ios/dep/libecho/libcombined/libecho.a \
-framework CoreMotion -framework CoreVideo -framework CoreMedia \
-framework AVFoundation -framework StoreKit -framework Foundation \
-framework UIKit -framework OpenGLES -framework QuartzCore -framework CoreAudio \
-framework AudioToolbox -framework CoreGraphics -framework CFNetwork \
-framework GameController -lz -lbz2 -lc++ -fobjc-link-runtime

LDFLAGS_PHONE = xcode-ios/dep/libfreeimage/libcombined/libfreeimage.a \
xcode-ios/dep/libSDL2/libcombined/libSDL2.a \
xcode-ios/dep/libfreetype/libcombined/libfreetype.a \
xcode-ios/dep/libreverb/libcombined/libreverb.a \
xcode-ios/dep/libSDL2_mixer/libcombined/libSDL2_mixer.a \
xcode-ios/dep/libecho/libcombined/libecho.a \
-framework CoreMotion -framework CoreVideo -framework CoreMedia \
-framework AVFoundation -framework StoreKit -framework Foundation \
-framework UIKit -framework OpenGLES -framework QuartzCore -framework CoreAudio \
-framework AudioToolbox -framework CoreGraphics -framework CFNetwork \
-framework GameController -lz -lbz2 -lc++ -fobjc-link-runtime

.SUFFIXES: .o-i386 .o-x86_64 .o-armv7 .o-armv7s .o-arm64 .m
MODULES_ARMV7 =  $(SRCS_TO_COMPILE:.c=.o-armv7) $(MSRCS_TO_COMPILE:.m=.o-armv7)
MODULES_ARMV7 := $(MODULES_ARMV7:.cpp=.o-armv7)
MODULES_ARMV7S =  $(SRCS_TO_COMPILE:.c=.o-armv7s) $(MSRCS_TO_COMPILE:.m=.o-armv7s)
MODULES_ARMV7S := $(MODULES_ARMV7S:.cpp=.o-armv7s)
MODULES_ARM64 =  $(SRCS_TO_COMPILE:.c=.o-arm64) $(MSRCS_TO_COMPILE:.m=.o-arm64)
MODULES_ARM64 := $(MODULES_ARM64:.cpp=.o-arm64)
MODULES_i386 = $(SRCS_TO_COMPILE:.c=.o-i386) $(MSRCS_TO_COMPILE:.m=.o-i386)
MODULES_i386 := $(MODULES_i386:.cpp=.o-i386)
MODULES_x86_64 = $(SRCS_TO_COMPILE:.c=.o-x86_64) $(MSRCS_TO_COMPILE:.m=.o-x86_64)
MODULES_x86_64 := $(MODULES_x86_64:.cpp=.o-x86_64)

default: all

copydeps:
	cp -r $(DEPS_INSTALLDIR)/* xcode-ios/dep/

all: $(TARGET)

$(TARGET): $(TARGET)-sim $(TARGET)-phone

$(TARGET)-sim: $(MODULES_i386) $(MODULES_x86_64) 

$(TARGET)-phone: $(MODULES_ARMV7) $(MODULES_ARMV7S) $(MODULES_ARM64) 

$(TARGET)-app: $(TARGET)-app-sim $(TARGET)-app-phone

$(TARGET)-app-sim: $(TARGET)-app-i386 $(TARGET)-app-x86_64

$(TARGET)-app-phone: $(TARGET)-app-armv7 $(TARGET)-app-armv7s $(TARGET)-app-arm64

$(TARGET)-app-armv7:
	$(CXX_PHONE) -arch armv7 -isysroot $(SDKROOT_PHONE) -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET) -o $(TARGET)-armv7.app $(MODULES_ARMV7) $(LDFLAGS_PHONE)

$(TARGET)-app-armv7s:
	$(CXX_PHONE) -arch armv7s -isysroot $(SDKROOT_PHONE) -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET) -o $(TARGET)-armv7s.app $(MODULES_ARMV7S) $(LDFLAGS_PHONE)

$(TARGET)-app-arm64:
	$(CXX_PHONE) -arch arm64 -isysroot $(SDKROOT_PHONE) -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET) -o $(TARGET)-arm64.app $(MODULES_ARM64) $(LDFLAGS_PHONE)

$(TARGET)-app-i386:
	$(CXX_PHONE) -arch i386 -isysroot $(SDKROOT_PHONE) -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET) -o $(TARGET)-i386.app $(MODULES_i386) $(LDFLAGS_PHONE)

$(TARGET)-app-x86_64:
	$(CXX_PHONE) -arch x86_64 -isysroot $(SDKROOT_PHONE) -miphoneos-version-min=$(IPHONEOS_DEPLOYMENT_TARGET) -o $(TARGET)-x86_64.app $(MODULES_x86_64) $(LDFLAGS_PHONE)

.c.o-i386:
	@echo " (CC-i386) $<"
	@$(CC_SIM) -arch $(ARCH_SIM_I386) $(CFLAGS_SIM) -c $< -o $@

.cpp.o-i386:
	@echo " (C++-i386) $<"
	@$(CXX_SIM) -arch $(ARCH_SIM_I386) $(CXXFLAGS_SIM) -c $< -o $@

.m.o-i386:
	@echo " (COBJ-i386) $<"
	@$(COBJ_SIM) -arch $(ARCH_SIM_I386) $(COBJFLAGS_SIM) -c $< -o $@

.c.o-x86_64:
	@echo " (CC-x86_64) $<"
	@$(CC_SIM) -arch $(ARCH_SIM_X86_64) $(CFLAGS_SIM) -c $< -o $@

.cpp.o-x86_64:
	@echo " (C++-x86_64) $<"
	@$(CXX_SIM) -arch $(ARCH_SIM_X86_64) $(CXXFLAGS_SIM) -c $< -o $@

.m.o-x86_64:
	@echo " (COBJ-x86_64) $<"
	@$(COBJ_SIM) -arch $(ARCH_SIM_X86_64) $(COBJFLAGS_SIM) -c $< -o $@

.c.o-armv7:
	@echo " (CC-armv7) $<"
	@$(CC_PHONE) -arch $(ARCH_PHONE_ARMV7) $(CFLAGS_PHONE) -c $< -o $@

.m.o-armv7:
	@echo " (COBJ-armv7) $<"
	@$(COBJ_PHONE) -arch $(ARCH_PHONE_ARMV7) $(COBJFLAGS_PHONE) -c $< -o $@

.cpp.o-armv7:
	@echo " (C++-armv7) $<"
	@$(CXX_PHONE) -arch $(ARCH_PHONE_ARMV7) $(CXXFLAGS_PHONE) -c $< -o $@

.c.o-armv7s:
	@echo " (CC-armv7s) $<"
	@$(CC_PHONE) -arch $(ARCH_PHONE_ARMV7S) $(CFLAGS_PHONE) -c $< -o $@

.cpp.o-armv7s:
	@echo " (C++-armv7s) $<"
	@$(CXX_PHONE) -arch $(ARCH_PHONE_ARMV7S) $(CXXFLAGS_PHONE) -c $< -o $@

.m.o-armv7s:
	@echo " (COBJ-armv7s) $<"
	@$(COBJ_PHONE) -arch $(ARCH_PHONE_ARMV7S) $(COBJFLAGS_PHONE) -c $< -o $@

.c.o-arm64:
	@echo " (CC-arm64) $<"
	@$(CC_PHONE) -arch $(ARCH_PHONE_ARM64) $(CFLAGS_PHONE) -c $< -o $@

.cpp.o-arm64:
	@echo " (C++-arm64) $<"
	@$(CXX_PHONE) -arch $(ARCH_PHONE_ARM64) $(CXXFLAGS_PHONE) -c $< -o $@

.m.o-arm64:
	@echo " (COBJ-arm64) $<"
	@$(COBJ_PHONE) -arch $(ARCH_PHONE_ARM64) $(COBJFLAGS_PHONE) -c $< -o $@

clean:
	rm -f core Dist/*.* u2dtmp* $(MODULES_i386) $(MODULES_x86_64) $(MODULES_ARMV7) $(MODULES_ARMV7S) $(MODULES_ARM64)

